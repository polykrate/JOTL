#|
Verify our timeslot implementation against official JAM test vectors
from: test/jamtestvectors/traces/fallback/

Each trace contains:
- pre_state:  State before block import (τ)
- block:      Block with header (HT)  
- post_state: State after block import (τ')

Gray Paper §6.1: τ' ≡ HT
The new timeslot τ' must equal the header slot HT.
|#

(defun hex-string-to-bytes (hex-string)
  "Converts hex string (0x...) to byte array"
  (let* ((clean (if (alexandria:starts-with-subseq "0x" hex-string)
                    (subseq hex-string 2)
                    hex-string))
         (len (/ (length clean) 2))
         (bytes (make-array len :element-type '(unsigned-byte 8))))
    (loop for i from 0 below len
          for j from 0 by 2 do
            (setf (aref bytes i) 
                  (parse-integer clean :start j :end (+ j 2) :radix 16)))
    bytes))

(defun bytes-to-hex-string (bytes)
  "Converts byte array to hex string (0x...)"
  (format nil "0x~{~2,'0x~}" (coerce bytes 'list)))

(defun decode-u32-le (bytes)
  "Decodes u32 little-endian from byte array"
  (logior (aref bytes 0)
          (ash (aref bytes 1) 8)
          (ash (aref bytes 2) 16)
          (ash (aref bytes 3) 24)))

