;;; MANUAL VERIFICATION EXAMPLE (from 00000010.json)
;;; ═══════════════════════════════════════════════════════════════

(defun test-manual-verification ()
  "Manual verification of block 00000010.json
   
   From actual test data:
   - PRE:  C11 = 0x09000000 → τ = 9
   - HEAD: slot = 10
   - POST: C11 = 0x0a000000 → τ' = 10
   
   Gray Paper §6.1: τ' ≡ HT
   9 → 10 ✅"
  
  (format t "~%Manual verification (block 00000010.json):~%")
  (format t "~%")
  
  ;; Simulate the values from the actual test vector
  (let ((tau 9)
        (HT 10)
        (tau-prime 10))
    
    (format t "  PRE-STATE:~%")
    (format t "    C11 key: 0x0b00...00~%")
    (format t "    Value:   0x09000000~%")
    (format t "    τ = ~D~%" tau)
    
    (multiple-value-bind (e m) (jotl::timeslot-to-epoch-and-phase tau)
      (format t "    e ℛ m = ~D/12 = ~D ℛ ~D~%~%" tau e m))
    
    (format t "  HEADER:~%")
    (format t "    slot (HT) = ~D~%~%" HT)
    
    (format t "  POST-STATE:~%")
    (format t "    C11 key: 0x0b00...00~%")
    (format t "    Value:   0x0a000000~%")
    (format t "    τ' = ~D~%" tau-prime)
    
    (multiple-value-bind (e-prime m-prime) (jotl::timeslot-to-epoch-and-phase tau-prime)
      (format t "    e' ℛ m' = ~D/12 = ~D ℛ ~D~%~%" tau-prime e-prime m-prime))
    
    (let ((valid (= tau-prime HT)))
      (format t "  Gray Paper §6.1: τ' ≡ HT~%")
      (format t "  ~A ~D == ~D ? ~A~%~%" 
              (if valid "✅" "❌")
              tau-prime HT valid)
      
      (assert valid)
      (format t "✓ Manual verification passed!~%"))))

