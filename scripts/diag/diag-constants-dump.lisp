;;; diag-constants-dump.lisp — Dump exact protocol constants (HC1 kind=0)
(in-package #:jotl)

(let ((buf (jam-host:encode-gp-constants)))
  (format t "~%Protocol constants: ~D bytes~%" (length buf))
  (format t "~%HEX:~%")
  (loop for i from 0 below (length buf) by 16 do
    (format t "  ~3D: ~{~2,'0X~^ ~}~%" i
            (coerce (subseq buf i (min (+ i 16) (length buf))) 'list)))
  (format t "~%Decoded fields:~%")
  (let ((pos 0))
    (flet ((r64 () (let ((v (logior (aref buf pos)
                                     (ash (aref buf (+ pos 1)) 8)
                                     (ash (aref buf (+ pos 2)) 16)
                                     (ash (aref buf (+ pos 3)) 24)
                                     (ash (aref buf (+ pos 4)) 32)
                                     (ash (aref buf (+ pos 5)) 40)
                                     (ash (aref buf (+ pos 6)) 48)
                                     (ash (aref buf (+ pos 7)) 56))))
                    (incf pos 8) v))
           (r32 () (let ((v (logior (aref buf pos)
                                     (ash (aref buf (+ pos 1)) 8)
                                     (ash (aref buf (+ pos 2)) 16)
                                     (ash (aref buf (+ pos 3)) 24))))
                    (incf pos 4) v))
           (r16 () (let ((v (logior (aref buf pos) (ash (aref buf (+ pos 1)) 8))))
                    (incf pos 2) v)))
      (format t "  B_I  = ~D~%" (r64))
      (format t "  B_L  = ~D~%" (r64))
      (format t "  B_S  = ~D~%" (r64))
      (format t "  C    = ~D~%" (r16))
      (format t "  D    = ~D~%" (r32))
      (format t "  E    = ~D~%" (r32))
      (format t "  G_A  = ~D~%" (r64))
      (format t "  G_I  = ~D~%" (r64))
      (format t "  G_R  = ~D~%" (r64))
      (format t "  G_T  = ~D~%" (r64))
      (format t "  H    = ~D~%" (r16))
      (format t "  I    = ~D~%" (r16))
      (format t "  J    = ~D~%" (r16))
      (format t "  K    = ~D~%" (r16))
      (format t "  L    = ~D~%" (r32))
      (format t "  N    = ~D~%" (r16))
      (format t "  O    = ~D~%" (r16))
      (format t "  P    = ~D~%" (r16))
      (format t "  Q    = ~D~%" (r16))
      (format t "  R    = ~D~%" (r16))
      (format t "  T    = ~D~%" (r16))
      (format t "  U    = ~D~%" (r16))
      (format t "  V    = ~D~%" (r16))
      (format t "  W_A  = ~D~%" (r32))
      (format t "  W_B  = ~D~%" (r32))
      (format t "  W_C  = ~D~%" (r32))
      (format t "  W_E  = ~D~%" (r32))
      (format t "  W_M  = ~D~%" (r32))
      (format t "  W_P  = ~D~%" (r32))
      (format t "  W_R  = ~D~%" (r32))
      (format t "  W_T  = ~D~%" (r32))
      (format t "  W_X  = ~D~%" (r32))
      (format t "  Y    = ~D~%" (r16))
      (format t "  pos  = ~D (expected 134)~%" pos))))

(sb-ext:exit :code 0)
