{
  "lisp.lsp.loadAsdSystem": true,
  "lisp.lsp.asdPath": "${workspaceFolder}/jotl.asd",
  "lisp.lsp.startupCommands": [
    "(require :asdf)",
    "(push #P\"${workspaceFolder}/\" asdf:*central-registry*)",
    "(asdf:load-system :jotl :verbose nil)"
  ],
  "commonlisp.lsp.loadAsdSystem": true,
  "commonlisp.lsp.asdPath": "${workspaceFolder}/jotl.asd",
  "alive.lsp.startupCommands": [
    "(require :asdf)",
    "(push #P\"${workspaceFolder}/\" asdf:*central-registry*)",
    "(asdf:load-system :jotl :verbose nil)"
  ]
}
